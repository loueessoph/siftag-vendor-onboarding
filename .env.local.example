# Copy to .env.local and fill in. Ask Sophie for the values, or pull them:
#   npx vercel@55.0.0 env pull .env.local --scope loueessophs-projects

# The shared Supabase project
NEXT_PUBLIC_SUPABASE_URL=
# Public key. Reads nothing here by design (RLS on, no policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Every vendor read and write runs under it
SUPABASE_SERVICE_ROLE_KEY=

# Unlocks /admin
ADMIN_PASSWORD=
# Signs the admin cookie
ADMIN_SESSION_SECRET=
# Retail assistants who work the floor console and till, as Name:password pairs.
STAFF_PASSWORDS=

# Not set yet. Without it, emails log instead of sending
RESEND_API_KEY=

# Used to build the vendor links you paste into emails and the URLs Stripe
# sends payers back to. Defaults to http://localhost:3002 when unset
NEXT_PUBLIC_SITE_URL=

# Payments (express checkout and the till). Test keys locally, live on Vercel
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (or of `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=
# Only needed in the browser by the till's card reader
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. Set to the Stripe Terminal location to take card-reader payments
# at the till; unset, the till shows a payment QR instead
# STRIPE_TERMINAL_LOCATION_ID=

# Optional. Defaults live in lib/email.ts
# EMAIL_FROM=Siftag <brands@siftag.com>
# ADMIN_EMAIL=brands@siftag.com
